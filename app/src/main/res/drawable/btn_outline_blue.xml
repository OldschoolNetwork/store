<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4EDDFF"
                android:endColor="#00B1D3"
                android:angle="270" /> <stroke android:width="3dp" android:color="#7ADAFF"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0091CF"
                android:endColor="#003088"
                android:angle="270" />
            <stroke android:width="3dp" android:color="#00BCD4"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

</selector>