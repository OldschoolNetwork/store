<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4433B5E5"
                android:endColor="#1133B5E5"
                android:angle="270" /> <stroke android:width="3dp" android:color="#33B5E5"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#242424"
                android:endColor="#121212"
                android:angle="270" />
            <stroke android:width="3dp" android:color="#00BCD4"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

</selector>