<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#58FF5C"
                android:endColor="#00FF05"
                android:angle="270" /> <stroke android:width="3dp" android:color="#92FF92"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#30CF00"
                android:endColor="#008805"
                android:angle="270" />
            <stroke android:width="3dp" android:color="#00FF00"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

</selector>