 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="We’ll be back soon" android:gravity="center" android:textColor="#00BCD4" android:textSize="30sp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="We are carrying out some work to improve ON Store. It will be available again soon.\n\nKind regards,\nOldschool Network Administration" android:gravity="center" android:textColor="#DDDDDD" android:textSize="16sp" android:layout_marginTop="24dp"/>
 <TextView android:id="@+id/maintenanceComment" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BBBBBB" android:gravity="center" android:layout_marginTop="24dp"/>
