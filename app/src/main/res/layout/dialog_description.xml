<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="16dp" android:padding="20dp" android:orientation="vertical" android:background="@drawable/bg_gradient">
    <ImageView android:id="@+id/descriptionClose" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="right" android:padding="8dp" android:src="@drawable/ic_cross_cancel" android:contentDescription="Close" />
    <TextView android:id="@+id/descriptionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textColor="#00BCD4" android:paddingBottom="16dp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><TextView android:id="@+id/descriptionFullText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#EEEEEE" android:lineSpacingExtra="4dp" android:textIsSelectable="true" /></ScrollView>
</LinearLayout>
