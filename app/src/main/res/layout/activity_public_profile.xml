<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient">
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal">
   <Button android:id="@+id/backPublicProfile" android:layout_width="72dp" android:layout_height="match_parent" android:text="Back" android:textColor="#00BCD4" android:background="@android:color/transparent"/>
   <TextView android:id="@+id/publicProfileHeading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="#00BCD4"/>
   <Button android:id="@+id/reportPublicProfile" android:layout_width="84dp" android:layout_height="match_parent" android:text="Report" android:textColor="#DDDDDD" android:background="@android:color/transparent"/>
  </LinearLayout>
  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#00BCD4"/>
  <ImageView android:id="@+id/publicStudioBanner" android:layout_width="match_parent" android:layout_height="120dp" android:scaleType="centerCrop" android:visibility="gone"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
   <ImageView android:id="@+id/publicProfileAvatar" android:layout_width="72dp" android:layout_height="72dp" android:scaleType="centerCrop" android:src="@drawable/ic_profile_placeholder"/>
   <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginLeft="16dp">
    <TextView android:id="@+id/publicProfileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="22sp"/>
    <TextView android:id="@+id/publicProfileRole" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF9800" android:textSize="14sp"/>
   </LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/publicStudioDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="6" android:ellipsize="end" android:textColor="#CCCCCC" android:textSize="14sp" android:paddingLeft="16dp" android:paddingRight="16dp"/>
  <Button android:id="@+id/openPublicStudio" android:layout_width="match_parent" android:layout_height="48dp" android:text="View studio" android:textColor="#00BCD4" android:background="@drawable/btn_outline_cyan" android:visibility="gone"/>
  <TextView android:id="@+id/publicProfileStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loading…" android:textColor="#AAAAAA" android:padding="16dp"/>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/publicStudioApps" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
 </LinearLayout>
 <FrameLayout android:id="@+id/publicProfileAppDetails" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient" android:visibility="gone"/>
</FrameLayout>
