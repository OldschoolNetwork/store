<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_gradient">
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <ImageView android:id="@+id/btnBackLibrary" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="12dp" android:padding="8dp" android:src="@drawable/ic_arrow_right" android:rotation="180" android:contentDescription="Back" android:background="?android:attr/selectableItemBackground" />
  <FrameLayout android:id="@+id/libraryContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
 </LinearLayout>
 <FrameLayout android:id="@+id/libraryDetails" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
</FrameLayout>
