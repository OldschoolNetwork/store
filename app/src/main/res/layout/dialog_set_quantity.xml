<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#222222"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set Quantity"
        android:textColor="#00BCD4"
        android:textSize="22sp"
        android:gravity="center"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvDialogRate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1 ONP = 2 Golden Coins"
        android:textColor="#888888"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Крупное количество выбранного -->
    <TextView
        android:id="@+id/tvDialogLargeQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 Coins"
        android:textColor="#FFC107"
        android:textSize="40sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <SeekBar
        android:id="@+id/sbQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:thumb="@drawable/ic_radio_selected"
        android:layout_marginBottom="4dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#888888"
            android:layout_alignParentStart="true"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:id="@+id/tvDialogMaxLimit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Max: 900 ONP"
            android:textColor="#888888"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>

    <!-- Кнопки Плюс -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="8dp">
        <Button android:id="@+id/btnAdd1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+1" android:backgroundTint="#333" android:textColor="#FFF" android:layout_marginRight="4dp"/>
        <Button android:id="@+id/btnAdd10" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+10" android:backgroundTint="#333" android:textColor="#FFF" android:layout_marginLeft="2dp" android:layout_marginRight="2dp"/>
        <Button android:id="@+id/btnAdd100" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+100" android:backgroundTint="#333" android:textColor="#FFF" android:layout_marginLeft="4dp"/>
    </LinearLayout>

    <!-- Кнопки Минус -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="24dp">
        <Button android:id="@+id/btnSub1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="-1" android:backgroundTint="#333" android:textColor="#FFF" android:layout_marginRight="4dp"/>
        <Button android:id="@+id/btnSub10" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="-10" android:backgroundTint="#333" android:textColor="#FFF" android:layout_marginLeft="2dp" android:layout_marginRight="2dp"/>
        <Button android:id="@+id/btnSub100" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="-100" android:backgroundTint="#333" android:textColor="#FFF" android:layout_marginLeft="4dp"/>
    </LinearLayout>

    <!-- Добавить в корзину -->
    <Button
        android:id="@+id/btnDialogAddToCart"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#FF9800"
        android:text="Add to cart"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"/>
</LinearLayout>