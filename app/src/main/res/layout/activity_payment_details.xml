<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_inversion"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Заголовок -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Purchase details"
        android:textColor="#00BCD4"
        android:textSize="24sp"
        android:fontFamily="sans-serif-light"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp" />

    <!-- Верхний циановый разделитель -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#00BCD4" />

    <!-- Центр (Скроллируемый скучный лог ошибки) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="6dp"
            android:text="[ERROR] ON_STORE_TRANSACTION_FAILED\n
[INFO] Initializing handshake protocols with game endpoint... OK\n
[INFO] Pinging game server cluster nodes... TIMEOUT\n
[WARN] Connection state: UNSTABLE (packet loss > 45%)\n\n
The remote game server did not respond to the token validation request sent by Oldschool Network Store secure layer. This usually happens when the backend service of the requested application is undergoing unscheduled maintenance, experiencing high loads, or node configuration synchronization mismatch.\n\n
----------------------------------------\n
SERVER RAW RESPONSES (SIMULATED):\n
----------------------------------------\n
HTTP/1.1 504 Gateway Timeout\n
Date: Tue, 30 Jun 2026 13:42:11 GMT\n
Server: nginx/1.18.0 (Ubuntu)\n
Content-Type: text/html\n
Content-Length: 192\n
Connection: keep-alive\n\n
&lt;html&gt;\n
&lt;head&gt;&lt;title&gt;504 Gateway Time-out&lt;/title&gt;&lt;/head&gt;\n
&lt;body&gt;\n
&lt;center&gt;&lt;h1&gt;504 Gateway Time-out&lt;/h1&gt;&lt;/center&gt;\n
&lt;/body&gt;\n
&lt;/html&gt;\n\n
[FATAL] Transaction aborted. No points were deducted from your ON Points balance. Please ensure your device network stability or contact developers via support channel if the issue persists." />
    </ScrollView>

    <!-- Нижний циановый разделитель -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#00BCD4"
        android:layout_marginBottom="16dp" />

    <!-- Нижние кнопки (Саппорт меньше по ширине) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDetailsBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:layout_marginEnd="12dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/btn_outline_gray"
            android:gravity="center"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnDetailsSupport"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_outline_orange"
            android:gravity="center"
            android:text="Support"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>